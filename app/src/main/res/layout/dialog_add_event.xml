<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:text="新建日程"
            android:textColor="#876BCA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#888888" />
    </RelativeLayout>

    <!-- 标题输入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_title"
            android:contentDescription="Title Icon"
            android:tint="#876BCA"/>

        <EditText
            android:id="@+id/etEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:hint="输入标题..."
            android:paddingStart="12dp"
            android:padding="8dp"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 日期和时间选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- 日期选择 -->
        <LinearLayout
            android:id="@+id/btnSelectDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Calendar Icon"
                android:tint="#876BCA"/>

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="2026-01-20"
                android:textSize="14sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- 时间选择 -->
        <LinearLayout
            android:id="@+id/btnSelectTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_schedule"
                android:contentDescription="Time Icon"
                android:tint="#876BCA"/>

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="09:00"
                android:textSize="14sp"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 备注输入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Description Icon"
            android:layout_marginTop="2dp"
            android:tint="#876BCA"/>

        <EditText
            android:id="@+id/etEventDesc"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="添加备注..."
            android:gravity="top|start"
            android:paddingStart="12dp"
            android:padding="8dp"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 提前提醒 -->
    <LinearLayout
        android:id="@+id/btnSelectRemind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:contentDescription="Reminder Icon"
            android:tint="#876BCA"/>

        <!-- 组合式提醒时间显示 -->
        <LinearLayout
            android:id="@+id/layoutRemindTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp">

            <!-- 场景1：不提醒 -->
            <TextView
                android:id="@+id/tvNoRemind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不提醒"
                android:textSize="14sp"
                android:textColor="#000000"
                android:visibility="gone"/>

            <!-- 场景2：有提醒 (提前 [xx] 分钟提醒) -->
            <LinearLayout
                android:id="@+id/layoutRemindDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="提前"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvRemindValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:background="@drawable/bg_input_small"
                    android:gravity="center"
                    android:text="15"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:layout_marginHorizontal="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分钟提醒"
                    android:textSize="14sp"
                    android:textColor="#000000"/>
            </LinearLayout>

        </LinearLayout>

        <!-- 原来的 TextView 隐藏掉，用上面的替代，保留ID引用以防报错，或者直接删除并在代码中修改 -->
        <TextView
            android:id="@+id/tvRemindTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="提前 15 分钟提醒"
            android:textSize="14sp"
            android:textColor="#000000"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:backgroundTint="#D7D7D7"
            android:textColor="#666666"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存"
            android:backgroundTint="#876BCA"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
